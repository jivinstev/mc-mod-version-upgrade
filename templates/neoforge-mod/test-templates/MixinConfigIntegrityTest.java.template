package PACKAGE_PLACEHOLDER;

import static org.junit.jupiter.api.Assertions.assertTrue;
import java.io.IOException;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
import org.junit.jupiter.api.Test;

/**
 * Guards catalog R/#43: a mixin listed in <modid>.mixins.json with no compiled class is
 * never woven in -> ClassCastException at runtime, invisible to javac. Asserts every mixin
 * in the config has a compiled .class. Reads class *files* (no linking of MC types).
 */
public class MixinConfigIntegrityTest {
    private static final Path DIR = Paths.get(System.getProperty("user.dir"));
    private static final Path MIXIN_CONFIG = DIR.resolve("src/main/resources/MODID.mixins.json"); // <-- EDIT
    private static final Path MAIN_CLASSES = DIR.resolve("build/classes/java/main");

    @Test
    void everyMixinInConfigHasACompiledClass() throws IOException {
        String json = Files.readString(MIXIN_CONFIG);
        String pkg = find(json, "\"package\"\\s*:\\s*\"([^\"]+)\"");
        assertTrue(pkg != null && !pkg.isBlank(), "mixin config must declare a package");
        Path pkgDir = MAIN_CLASSES.resolve(pkg.replace('.', '/'));
        List<String> mixins = new ArrayList<>();
        for (String k : new String[]{"mixins", "client", "server"}) mixins.addAll(array(json, k));
        assertTrue(!mixins.isEmpty(), "expected at least one mixin");
        List<String> missing = new ArrayList<>();
        for (String n : mixins)
            if (!Files.exists(pkgDir.resolve(n.replace('.', '/') + ".class"))) missing.add(n);
        assertTrue(missing.isEmpty(), "mixin(s) with no compiled class (will crash at runtime):\n  " + String.join("\n  ", missing));
    }
    /**
     * The reverse direction, and the one a port gets wrong: a mixin class that exists but is listed in NO
     * config is never applied, so every cast to it (an accessor, an invoker) is a ClassCastException at
     * runtime. Measured: a burn-down worker added a new accessor to replace a removed API and never
     * registered it -- javac, Gate A's forward check and the baseline GameTests all passed.
     * A class counts as a mixin when its bytecode carries the @Mixin annotation.
     */
    @Test
    void everyMixinClassIsListedInAConfig() throws IOException {
        String json = Files.readString(MIXIN_CONFIG);
        String pkg = find(json, "\"package\"\\s*:\\s*\"([^\"]+)\"");
        Path pkgDir = MAIN_CLASSES.resolve(pkg.replace('.', '/'));
        Set<String> listed = new HashSet<>();
        try (DirectoryStream<Path> cfgs = Files.newDirectoryStream(MIXIN_CONFIG.getParent(), "*mixins*.json")) {
            for (Path cfg : cfgs) {
                String c = Files.readString(cfg);
                if (!pkg.equals(find(c, "\"package\"\\s*:\\s*\"([^\"]+)\""))) continue;
                for (String k : new String[]{"mixins", "client", "server"}) listed.addAll(array(c, k));
            }
        }
        List<String> unlisted = new ArrayList<>();
        try (var files = Files.walk(pkgDir)) {
            for (Path f : (Iterable<Path>) files.filter(x -> x.toString().endsWith(".class"))::iterator) {
                String bytes = new String(Files.readAllBytes(f), java.nio.charset.StandardCharsets.ISO_8859_1);
                if (!bytes.contains("Lorg/spongepowered/asm/mixin/Mixin;")) continue;
                String name = pkgDir.relativize(f).toString().replace('\\', '/').replaceAll("\\.class$", "").replace('/', '.');
                if (!listed.contains(name)) unlisted.add(name);
            }
        }
        Collections.sort(unlisted);
        assertTrue(unlisted.isEmpty(), "mixin class(es) listed in no config (never applied; casts to them fail at runtime):\n  "
                + String.join("\n  ", unlisted));
    }
    private static String find(String s, String re) { Matcher m = Pattern.compile(re).matcher(s); return m.find() ? m.group(1) : null; }
    private static List<String> array(String s, String key) {
        List<String> out = new ArrayList<>();
        Matcher b = Pattern.compile("\"" + key + "\"\\s*:\\s*\\[(.*?)\\]", Pattern.DOTALL).matcher(s);
        if (b.find()) { Matcher it = Pattern.compile("\"([^\"]+)\"").matcher(b.group(1)); while (it.find()) out.add(it.group(1)); }
        return out;
    }
}
