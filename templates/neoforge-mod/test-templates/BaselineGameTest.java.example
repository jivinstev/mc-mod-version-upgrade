// ─── TEMPLATE (Gate B baseline). tools/scaffold-gametest.py writes it into a port, substituting the
// package and the "examplemod" literals. It names NO class of the mod: every test walks the mod's own
// registries, so it is correct for any mod as written and needs no model to adapt it. Mod-specific
// outcome tests (does the shield still block?) come from tools/behaviour-tests.py, which reads this
// file for its annotations and template name.
package com.example.examplemod.test;

import java.util.ArrayList;
import java.util.List;

import net.minecraft.core.BlockPos;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.gametest.framework.GameTest;
import net.minecraft.gametest.framework.GameTestHelper;
import net.minecraft.nbt.NbtOps;
import net.minecraft.nbt.Tag;
import net.minecraft.resources.RegistryOps;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.MobCategory;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.SpawnEggItem;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.state.BlockState;
import net.neoforged.neoforge.gametest.GameTestHolder;
import net.neoforged.neoforge.gametest.PrefixGameTestTemplate;

/**
 * Baseline runtime load test: the mod's content exists, constructs and runs, on a dedicated server.
 * Catches the §R load-time patterns a clean compile hides (config read at registration, unbound
 * holders, a broken entity constructor or attribute supplier, a block whose state or block entity
 * fails, an item stack whose components do not encode). Failures are collected and reported together,
 * truncated (catalog #164: a long GameTest message crashes the lectern-book save at shutdown).
 */
@GameTestHolder("examplemod")
@PrefixGameTestTemplate(false)
public class BaselineGameTest {
    private static final String NS = "examplemod";
    private static final BlockPos AT = new BlockPos(4, 2, 4);

    /** Every entity type constructs, joins the level and survives 20 ticks of AI and physics. */
    @GameTest(template = "empty_test", timeoutTicks = 200)
    public static void everyEntitySpawnsAndTicks(GameTestHelper helper) {
        ServerLevel level = helper.getLevel();
        List<String> failed = new ArrayList<>();
        int n = 0;
        for (EntityType<?> type : BuiltInRegistries.ENTITY_TYPE) {
            if (!NS.equals(BuiltInRegistries.ENTITY_TYPE.getKey(type).getNamespace())) continue;
            n++;
            try {
                Entity e = type.create(level);
                if (e == null) { failed.add(BuiltInRegistries.ENTITY_TYPE.getKey(type) + ": create returned null"); continue; }
                BlockPos p = helper.absolutePos(AT);
                e.moveTo(p.getX() + 0.5, p.getY(), p.getZ() + 0.5, 0f, 0f);
                if (!level.addFreshEntity(e)) failed.add(BuiltInRegistries.ENTITY_TYPE.getKey(type) + ": the level refused it");
            } catch (Throwable t) {
                failed.add(BuiltInRegistries.ENTITY_TYPE.getKey(type) + ": " + t);
            }
        }
        report(helper, "entity", n, failed, 20);
    }

    /** Every spawn egg names a type, and that type is one this mod (or vanilla) registers. */
    @GameTest(template = "empty_test")
    public static void everySpawnEggHasAType(GameTestHelper helper) {
        List<String> failed = new ArrayList<>();
        int n = 0;
        for (Item item : BuiltInRegistries.ITEM) {
            if (!(item instanceof SpawnEggItem egg) || !NS.equals(BuiltInRegistries.ITEM.getKey(item).getNamespace())) continue;
            n++;
            try {
                EntityType<?> type = egg.getType(new ItemStack(item));
                if (type == null) failed.add(BuiltInRegistries.ITEM.getKey(item) + ": no entity type");
            } catch (Throwable t) {
                failed.add(BuiltInRegistries.ITEM.getKey(item) + ": " + t);
            }
        }
        report(helper, "spawn egg", n, failed, 0);
    }

    /** Every block places in its default state and reads back; a block entity, if any, is created. */
    @GameTest(template = "empty_test", timeoutTicks = 200)
    public static void everyBlockPlaces(GameTestHelper helper) {
        List<String> failed = new ArrayList<>();
        List<String> needsSupport = new ArrayList<>();
        int n = 0;
        for (Block block : BuiltInRegistries.BLOCK) {
            if (!NS.equals(BuiltInRegistries.BLOCK.getKey(block).getNamespace())) continue;
            n++;
            try {
                BlockState state = block.defaultBlockState();
                // a crop that needs water or farmland, a wall torch: the block itself says it cannot live on a
                // plain floor, so popping off here is correct behaviour, not a failure
                if (!state.canSurvive(helper.getLevel(), helper.absolutePos(AT))) {
                    needsSupport.add(BuiltInRegistries.BLOCK.getKey(block).toString());
                    continue;
                }
                helper.setBlock(AT, state);
                if (helper.getBlockState(AT).getBlock() != block) {
                    failed.add(BuiltInRegistries.BLOCK.getKey(block) + ": did not stay placed");
                } else if (state.hasBlockEntity() && helper.getBlockEntity(AT) == null) {
                    failed.add(BuiltInRegistries.BLOCK.getKey(block) + ": no block entity");
                }
            } catch (Throwable t) {
                failed.add(BuiltInRegistries.BLOCK.getKey(block) + ": " + t);
            }
        }
        if (!needsSupport.isEmpty())
            System.out.println("EXAMPLEMOD_BASELINE: block skipped " + needsSupport.size() + " that need a support the plain floor lacks: "
                + String.join(", ", needsSupport.subList(0, Math.min(12, needsSupport.size()))));
        report(helper, "block", n, failed, 5);
    }

    /** Every item's default stack encodes and decodes with the registry codec (catalog R24's shape). */
    @GameTest(template = "empty_test")
    public static void everyItemStackRoundTrips(GameTestHelper helper) {
        RegistryOps<Tag> ops = RegistryOps.create(NbtOps.INSTANCE, helper.getLevel().registryAccess());
        List<String> failed = new ArrayList<>();
        int n = 0;
        for (Item item : BuiltInRegistries.ITEM) {
            if (!NS.equals(BuiltInRegistries.ITEM.getKey(item).getNamespace())) continue;
            n++;
            try {
                ItemStack stack = item.getDefaultInstance();
                if (stack.isEmpty()) continue;
                Tag tag = ItemStack.CODEC.encodeStart(ops, stack).getOrThrow();
                ItemStack back = ItemStack.CODEC.parse(ops, tag).getOrThrow();
                if (back.getItem() != item) failed.add(BuiltInRegistries.ITEM.getKey(item) + ": decoded as " + back.getItem());
            } catch (Throwable t) {
                failed.add(BuiltInRegistries.ITEM.getKey(item) + ": " + t);
            }
        }
        report(helper, "item", n, failed, 0);
    }

    private static void report(GameTestHelper helper, String what, int n, List<String> failed, int ticks) {
        Runnable done = () -> {
            for (String f : failed) System.out.println("EXAMPLEMOD_BASELINE: " + what + " FAILED " + f);
            System.out.println("EXAMPLEMOD_BASELINE: " + what + " checked " + n + ", failed " + failed.size());
            if (failed.isEmpty()) {
                helper.succeed();
            } else {
                String msg = failed.size() + " " + what + "(s) failed: " + String.join("; ", failed);
                helper.fail(msg.length() > 500 ? msg.substring(0, 500) + "..." : msg);
            }
        };
        if (ticks > 0) helper.runAfterDelay(ticks, done); else done.run();
    }
}
