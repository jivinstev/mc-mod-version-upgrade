// Persistence round-trip = P0 target in every migration's churn list (all 37 serializable types in
// one port rewrote saveAdditional for the HolderLookup.Provider). This class is namespace-driven,
// so it already covers the whole bucket with no per-mod edits. Context:
// .claude/skills/migrate-mod/references/test-targets.md.
package com.example.examplemod.test;

import java.util.ArrayList;
import java.util.List;

import net.minecraft.core.BlockPos;
import net.minecraft.core.HolderLookup;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.gametest.framework.GameTest;
import net.minecraft.gametest.framework.GameTestHelper;
import net.minecraft.nbt.CompoundTag;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.EntityBlock;
import net.minecraft.world.level.block.entity.BlockEntity;
import net.neoforged.neoforge.gametest.GameTestHolder;
import net.neoforged.neoforge.gametest.PrefixGameTestTemplate;

/**
 * Gate B — persistence round-trip. Exercises the save/load serialization surface that a bare
 * "does it load + tick" GameTest never touches: {@code addAdditionalSaveData}/{@code readAdditionalSaveData}
 * on every entity, and {@code saveAdditional}/{@code load} on every block entity.
 *
 * NBT round-trips are a classic migration crash class (a field written by save but not read by load,
 * a 1.20→1.21 tag/codec change, a null on a fresh instance). None of it runs until a chunk is saved
 * and reloaded — which no other gate does. Here each object is saved → loaded into a fresh instance →
 * re-saved: a crash in save or load fails the test, and a save↔re-save asymmetry is logged as a likely
 * bug (a field that isn't being read back).
 *
 * Standard for every migration — this file is namespace-driven (iterate {@code BuiltInRegistries} filtered
 * to your modid), so it needs no per-mod edits beyond the {@code "examplemod"} literals.
 */
@GameTestHolder("examplemod")
@PrefixGameTestTemplate(false)
public class PersistenceGameTest {
    private static final String MODID = "examplemod";
    private static final BlockPos SPAWN = new BlockPos(4, 1, 4);
    private static final BlockPos BLOCK_POS = new BlockPos(2, 1, 2);

    /** Every serializable {@code <modid>:*} entity survives a save → load → re-save round-trip. */
    @GameTest(template = "empty_test")
    public void everyEntitySurvivesNbtRoundTrip(GameTestHelper helper) {
        ServerLevel level = helper.getLevel();
        List<String> failures = new ArrayList<>();
        List<String> asymmetries = new ArrayList<>();
        int checked = 0;
        for (EntityType<?> type : BuiltInRegistries.ENTITY_TYPE) {
            ResourceLocation id = BuiltInRegistries.ENTITY_TYPE.getKey(type);
            if (!MODID.equals(id.getNamespace()) || !type.canSerialize()) continue; // only disk-persisted entities
            try {
                Entity src = helper.spawn((EntityType) type, SPAWN);
                CompoundTag tag = src.saveWithoutId(new CompoundTag());   // addAdditionalSaveData
                Entity fresh = type.create(level);
                if (fresh == null) { failures.add(id + ": create() returned null"); src.discard(); continue; }
                fresh.load(tag);                                          // readAdditionalSaveData
                CompoundTag tag2 = fresh.saveWithoutId(new CompoundTag()); // re-save must not crash either
                if (!tag.equals(tag2)) asymmetries.add(id.toString());
                src.discard();
                checked++;
            } catch (Throwable t) {
                failures.add(id + " -> " + t);
            }
        }
        helper.assertTrue(checked > 0, "found no serializable " + MODID + " entities to round-trip");
        if (!asymmetries.isEmpty()) {
            // Not a hard fail (some fields are legitimately non-deterministic), but worth investigating:
            // a save↔re-save mismatch usually means load() doesn't read something save() wrote.
            System.out.println("PERSISTENCE: entity save↔re-save asymmetry (investigate): " + asymmetries);
        }
        helper.assertTrue(failures.isEmpty(), "entity NBT round-trip failures: " + failures);
        helper.succeed();
    }

    /** Every {@code <modid>:*} block entity survives a save → load → re-save round-trip. */
    @GameTest(template = "empty_test")
    public void everyBlockEntitySurvivesNbtRoundTrip(GameTestHelper helper) {
        ServerLevel level = helper.getLevel();
        HolderLookup.Provider registries = level.registryAccess();
        List<String> failures = new ArrayList<>();
        int checked = 0;
        for (Block block : BuiltInRegistries.BLOCK) {
            ResourceLocation id = BuiltInRegistries.BLOCK.getKey(block);
            if (!MODID.equals(id.getNamespace()) || !(block instanceof EntityBlock)) continue;
            try {
                helper.setBlock(BLOCK_POS, block);
                BlockEntity be = helper.getBlockEntity(BLOCK_POS);
                if (be == null) { failures.add(id + ": no block entity after placement"); continue; }
                CompoundTag tag = be.saveWithFullMetadata(registries); // saveAdditional
                be.loadWithComponents(tag, registries);               // load
                be.saveWithFullMetadata(registries);                  // re-save must not crash
                checked++;
            } catch (Throwable t) {
                failures.add(id + " -> " + t);
            }
        }
        // A mod may legitimately have zero block entities — that's a pass, not a failure.
        helper.assertTrue(failures.isEmpty(), "block-entity NBT round-trip failures: " + failures);
        System.out.println("PERSISTENCE: round-tripped " + checked + " " + MODID + " block entity type(s)");
        helper.succeed();
    }
}
